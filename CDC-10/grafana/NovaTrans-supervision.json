{
  "uid": "novatrans-supervision",
  "title": "NovaTrans - Supervision réseau",
  "tags": [
    "novatrans",
    "snmp"
  ],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Équipement",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-novatrans"
        },
        "query": {
          "query": "label_values(up{job=\"snmp\"}, device)",
          "refId": "v"
        },
        "definition": "label_values(up{job=\"snmp\"}, device)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Équipements joignables (SNMP)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-novatrans"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-novatrans"
          },
          "expr": "up{job=\"snmp\",device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
